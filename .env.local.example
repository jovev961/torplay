# Optional external FlareSolverr service for Cardigann definitions that require it.
FLARESOLVERR_URL=
# Advanced full-provider override using saved source IDs.
# TORPLAY_SEARCH_PROVIDERS=custom-provider-id,cardigann-provider-id

# Optional server-side OMDb key for IMDb card ratings.
OMDB_API_KEY=replace-me

# Server-only TMDB API Read Access Token used for movie and show metadata.
TMDB_API_TOKEN=

# Persistent local profiles and watch history. Defaults to this path when omitted.
TORPLAY_DATABASE_PATH=persistent-data/torplay.db
# Optional next-episode countdown in seconds (3-60, default 10).

# Optional. Defaults to .data/torrents inside this project.
TORRENT_DOWNLOAD_PATH=.data/torrents
# Optional comma-separated public trackers. Empty uses TorPlay defaults; "none" disables fallbacks.
# TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,https://tracker.opentrackr.org:443/announce,udp://tracker.torrent.eu.org:451/announce
# FFMPEG_PATH=/absolute/path/to/ffmpeg

# Optional server-side subtitle providers. Playback continues when either provider is absent.
# OPENSUBTITLES_API_KEY=replace-me
# OPENSUBTITLES_USER_AGENT=TorPlay v0.1
# SUBDL_API_KEY=replace-me

# Subtitle languages are configured per profile from Manage Profiles.
SUBTITLE_CACHE_PATH=.data/subtitles
SUBTITLE_CACHE_TTL_DAYS=30

# Centralized seek buffer target. The implementation may clamp its byte window per file.
PLAYBACK_BUFFER_AHEAD_SECONDS=60

# Windows home runtime. Next.js stays private behind the LAN-facing port-80 proxy.
TORPLAY_HOST=127.0.0.1
TORPLAY_PORT=3000
TORPLAY_PUBLIC_HOSTNAME=torplay.local
TORPLAY_PUBLIC_PORT=80
# Optional interface name or local IP when VPN/virtual adapters confuse mDNS selection.
# TORPLAY_MDNS_INTERFACE=Wi-Fi
