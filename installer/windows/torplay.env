# TorPlay owner configuration. Restart TorPlay after changing this file.

JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=replace-me
JACKETT_MOVIE_INDEXERS=yts,limetorrents,torrentdownload,torrentdownloads,knaben
JACKETT_SHOW_INDEXERS=eztv,limetorrents,torrentdownload,knaben,kickasstorrents-ws

# Server-only metadata provider credentials.
TMDB_API_TOKEN=replace-me
# Optional: IMDb card ratings and Jackett IMDb-only search fallback.
# OMDB_API_KEY=replace-me

# Optional server-side subtitle providers.
# OPENSUBTITLES_API_KEY=replace-me
# OPENSUBTITLES_USER_AGENT=TorPlay v0.1
# SUBDL_API_KEY=replace-me

# Subtitle languages are configured per profile from Manage Profiles.
PLAYBACK_BUFFER_AHEAD_SECONDS=60

# The installer supplies writable data/cache defaults. Uncomment only to override them.
# TORPLAY_DATABASE_PATH=C:\path\to\torplay.db
# TORRENT_DOWNLOAD_PATH=C:\path\to\temporary\torrents
# SUBTITLE_CACHE_PATH=C:\path\to\subtitle-cache
SUBTITLE_CACHE_TTL_DAYS=30

TORPLAY_HOST=127.0.0.1
TORPLAY_PORT=3000
TORPLAY_PUBLIC_HOSTNAME=torplay.local
TORPLAY_PUBLIC_PORT=80
# TORPLAY_MDNS_INTERFACE=Wi-Fi
