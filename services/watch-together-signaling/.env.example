# In-process room storage for local development and single-process ephemeral deployments.
WATCH_TOGETHER_STORE=memory

# For production, change WATCH_TOGETHER_STORE above to redis. Redis mode still
# keeps active rooms and live signaling in memory; Redis stores only recovery data.
# WATCH_TOGETHER_REDIS_URL=rediss://default:password@redis.example.com:6379
# WATCH_TOGETHER_REDIS_PREFIX=torplay:watch-together

# Optional comma-separated exact browser origins allowed to open signaling sockets.
# WATCH_TOGETHER_ALLOWED_ORIGINS=https://torplay.example.com

HOST=127.0.0.1
PORT=8787
